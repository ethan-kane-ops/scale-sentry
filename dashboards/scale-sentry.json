{
  "title": "scale-sentry",
  "uid": "scale-sentry-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["scale-sentry", "kubernetes", "hpa"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs by verdict (6h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 5 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "expr": "sum by (verdict) (increase(scale_sentry_runs_total[6h]))", "legendFormat": "{{verdict}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Run duration (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(scale_sentry_run_duration_seconds_bucket[10m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(scale_sentry_run_duration_seconds_bucket[10m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HPA reaction latency (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(scale_sentry_hpa_react_seconds_bucket[10m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(scale_sentry_hpa_react_seconds_bucket[10m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Diagnostic alerts (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 9 },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true } } }
      ],
      "targets": [
        { "expr": "sum by (alert, severity) (increase(scale_sentry_diagnostic_alerts_total[24h]))", "format": "table", "instant": true, "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reconcile errors (controller-runtime)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "targets": [
        { "expr": "sum by (controller, result) (rate(controller_runtime_reconcile_total{controller=\"scalevalidation\"}[5m]))", "legendFormat": "{{result}}", "refId": "A" }
      ]
    }
  ]
}
